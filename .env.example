# 复制为 .env 并填入真实值（.env 不会提交到 Git）
# cp .env.example .env

# 第三方 / OpenAI 兼容 API（bootstrap 会 export，供 Codex env_key 读取）
OPENAI_API_KEY=sk-your-api-key-here

# 若已有 ~/claude-setup/.env 且其中配置了 ANTHROPIC_AUTH_TOKEN，
# 可不单独填 OPENAI_API_KEY：bootstrap 会自动映射复用。

# MCP 常用密钥示例（按实际使用的 MCP 保留/删除）

# GitHub MCP
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxx

# Brave Search MCP
# BRAVE_API_KEY=xxxxxxxx
