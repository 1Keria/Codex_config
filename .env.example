# 复制为 .env 并填入真实值（.env 不会提交到 Git）
# cp .env.example .env

# 第三方 API（bootstrap / 包装器注入，对应 Claude 的 ANTHROPIC_AUTH_TOKEN）
OPENAI_API_KEY=sk-your-api-key-here

# 若已有 ~/claude-setup/.env 里的 ANTHROPIC_AUTH_TOKEN，可不填上面这项

# MCP 常用密钥示例（按实际使用的 MCP 保留/删除）

# GitHub MCP
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxx

# Brave Search MCP
# BRAVE_API_KEY=xxxxxxxx
